{
  "name": "vanguard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "server": "uv run --directory server start",
    "server:dev": "uv run --directory server dev",
    "ios": "bun run --cwd ios start",
