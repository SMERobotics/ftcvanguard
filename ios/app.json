{
  "expo": {
    "name": "Vanguard",
    "slug": "vanguard",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Vanguard connects to a local development server to fetch data."
      }
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
